            elif conf >= 50:
                med_conf_bets.append((bet, f"{conf}%"))

        # Check O/U
        for threshold, data in consensus.get('over_under', {}).items():
            conf = int(data['confidence'].rstrip('%'))
            if conf >= 70:
                high_conf_bets.append((data['recommendation'], data['confidence']))
            elif conf >= 60:
                med_conf_bets.append((data['recommendation'], data['confidence']))

        # Check BTTS
        if 'btts' in consensus:
            conf = int(consensus['btts']['confidence'].rstrip('%'))
            bet = f"BTTS {consensus['btts']['prediction']}"
            if conf >= 70:
                high_conf_bets.append((bet, f"{conf}%"))
            elif conf >= 60:
                med_conf_bets.append((bet, f"{conf}%"))

        if high_conf_bets:
            report += "\n🟢 HIGH CONFIDENCE BETS (70%+):"
            for bet, conf in high_conf_bets:
                report += f"\n  • {bet} - {conf}"

        if med_conf_bets:
            report += "\n\n🟡 MEDIUM CONFIDENCE BETS (50-70%):"
            for bet, conf in med_conf_bets:
                report += f"\n  • {bet} - {conf}"

        if not high_conf_bets and not med_conf_bets:
            report += "\n⚠️ No high-confidence bets identified"

        # Warnings
        if len(self.successful_scrapes) < len(self.urls) / 2:
            report += f"""

⚠️ WARNING: Only {len(self.successful_scrapes)} out of {len(self.urls)} articles were successfully analyzed.
Results may not be fully representative."""

        report += f"""

{'=' * 80}
📝 DISCLAIMER: This analysis is for informational purposes only.
Always gamble responsibly and within your means.
{'=' * 80}
"""

        return report


