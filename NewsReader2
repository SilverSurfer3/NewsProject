{'=' * 80}
Match: {consensus['match']}
Date: {consensus['date']}
Articles Analyzed: {consensus['sources_analyzed']} ({consensus['success_rate']} success rate)
Overall Confidence: {consensus.get('overall_confidence', 'UNKNOWN')}
Generated: {datetime.now().strftime('%Y-%m-%d %H:%M')}

{'=' * 80}
🏆 MATCH RESULT PREDICTION
{'=' * 80}"""

        if 'winner' in consensus:
            w = consensus['winner']
