{'=' * 80}
📊 SCORE PREDICTIONS
{'=' * 80}
Most common predictions:"""
            for score, count in consensus['scores']['most_common']:
                report += f"\n  • {score}: {count} mentions"

        # Over/Under
        report += f"""

{'=' * 80}
📈 OVER/UNDER ANALYSIS
{'=' * 80}"""

        if consensus['over_under']:
            report += "\nThreshold    Recommendation    Confidence    Votes\n"
            report += "-" * 60 + "\n"

            for threshold in ['0.5', '1.5', '2.5', '3.5', '4.5']:
                if threshold in consensus['over_under']:
                    data = consensus['over_under'][threshold]
                    report += f"{threshold} goals    {data['recommendation']:<16} {data['confidence']:<13} {data['votes']}\n"

            # Find safest bets
            safe_bets = []
            for threshold, data in consensus['over_under'].items():
                conf_value = int(data['confidence'].rstrip('%'))
                if conf_value >= 70:
                    safe_bets.append((data['recommendation'], data['confidence']))

            if safe_bets:
                report += "\n✅ SAFEST O/U BETS:"
                for bet, conf in safe_bets:
                    report += f"\n  • {bet} ({conf} confidence)"
        else:
            report += "\nNo over/under predictions found"

        # BTTS
        if 'btts' in consensus:
            report += f"""

{'=' * 80}
⚽ BOTH TEAMS TO SCORE
{'=' * 80}
Prediction: {consensus['btts']['prediction']}
Confidence: {consensus['btts']['confidence']}
"""

        # Betting recommendations
        report += f"""

{'=' * 80}
💡 BETTING RECOMMENDATIONS
{'=' * 80}

Based on the analysis:
"""

        # Categorize bets by confidence
        high_conf_bets = []
        med_conf_bets = []

        # Check winner
        if 'winner' in consensus:
            conf = int(consensus['winner']['confidence'].rstrip('%'))
