    def fetch_article_content(self, url):
        """Enhanced web scraping with metadata extraction"""
        try:
            headers = {
                'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36'
            }

            response = requests.get(url, headers=headers, timeout=10)
            soup = BeautifulSoup(response.content, 'html.parser')

            # Remove scripts and styles
            for script in soup(["script", "style", "noscript"]):
                script.decompose()

            # Extract text
            text = ""
            selectors = [
                'article', 'main', 'div.content', 'div.article-body',
                'section.content', '.post-content', '.entry-content'
            ]

            for selector in selectors:
                elements = soup.select(selector)
                if elements:
                    for elem in elements:
                        text += elem.get_text(separator=' ', strip=True) + " "
                    if len(text) > 500:
                        break

            if len(text) < 500:
                paragraphs = soup.find_all('p')
                text = ' '.join([p.get_text(strip=True) for p in paragraphs])

            # Extract metadata
            author = self._extract_author(soup)
            publish_date = self._extract_date(soup)

            # Clean text
            text = re.sub(r'\s+', ' ', text).strip()

            return {
                'url': url,
                'domain': urlparse(url).netloc,
                'content': text[:15000],
                'author': author,
                'publish_date': publish_date,
                'status': 'success'
            }

        except Exception as e:
            return {
                'url': url,
                'domain': urlparse(url).netloc,
                'content': '',
                'status': f'error: {str(e)}'
            }

    def _extract_author(self, soup):
        """Extract author from article"""
        author_selectors = [
            'span.author', 'div.author', 'p.author',
            'span.by-author', 'span.ArticleHeader-author'
        ]

        for selector in author_selectors:
            author = soup.select_one(selector)
            if author:
                return author.get_text(strip=True)

        # Check meta tags
        author_meta = soup.find('meta', {'name': 'author'})
        if author_meta:
            return author_meta.get('content', '')

        return 'Unknown'

    def _extract_date(self, soup):
        """Extract publish date from article"""
        date_selectors = [
            'time', 'span.date', 'div.date', 'p.date',
            'span.publish-date', 'span.ArticleHeader-date'
        ]

        for selector in date_selectors:
            date_elem = soup.select_one(selector)
            if date_elem:
                return date_elem.get_text(strip=True)

        return None

    def extract_predictions_ml(self, text):
        """Extract predictions using ML + pattern matching"""
        predictions = {
            'winner': None,
            'winner_confidence': 0,
            'scores': [],
            'over_under': {},
            'btts': None,
            'implicit_predictions': {},
            'confidence_phrases': [],
            'reasoning_quality': 0
        }

        # Check if text is empty
        if not text or len(text.strip()) < 10:
            print("  ⚠️ Text too short for ML analysis, skipping...")
            return predictions

        # 1. PATTERN MATCHING (Original approach)
        predictions.update(self._pattern_based_extraction(text))

        # 2. ML-BASED EXTRACTION
        if self.classifier and len(text) > 50:  # Need minimum text length
            try:
                # Zero-shot classification for winner
                winner_labels = [self.home_team, self.away_team, "Draw"]

                # Use first 1000 chars or full text if shorter
                text_sample = text[:1000] if len(text) > 1000 else text

                result = self.classifier(
                    text_sample,
                    candidate_labels=winner_labels,
                    hypothesis_template="This text predicts {} will win the match"
                )

                # ML prediction
                ml_winner = result['labels'][0]
                ml_confidence = result['scores'][0]

                # Combine with pattern matching
                if not predictions['winner'] and ml_confidence > 0.6:
                    predictions['winner'] = ml_winner
                    predictions['winner_confidence'] = ml_confidence

                # Extract implicit predictions
                predictions['implicit_predictions'] = {
                    'ml_winner': ml_winner,
                    'ml_confidence': ml_confidence,
                    'all_scores': dict(zip(result['labels'], result['scores']))
                }
            except Exception as e:
                print(f"  ⚠️ ML classification error: {str(e)}")
                # Continue with pattern-based results

        # 3. CONFIDENCE PHRASE EXTRACTION
        predictions['confidence_phrases'] = self._extract_confidence_phrases(text)

        # 4. REASONING QUALITY ASSESSMENT
        predictions['reasoning_quality'] = self._assess_reasoning_quality(text)

        return predictions

    def _pattern_based_extraction(self, text):
        """Original pattern-based extraction"""
        results = {}

        # Winner patterns
        winner_patterns = [
            (rf'{self.home_team}\s+(?:to |will |should )\s*win', self.home_team),
            (rf'{self.away_team}\s+(?:to |will |should )\s*win', self.away_team),
            (r'draw|tie|stalemate', 'Draw')
        ]

        for pattern, team in winner_patterns:
            if re.search(pattern, text, re.IGNORECASE):
                results['winner'] = team
                break

        # Score extraction
        score_patterns = [
            r'(?:predict|prediction|forecast).*?(\d)\s*[-–:]\s*(\d)',
            rf'{self.home_team}\s+(\d)\s*[-–:]\s*(\d)\s*{self.away_team}'
        ]

        scores = set()
        for pattern in score_patterns:
            matches = re.findall(pattern, text[:5000], re.IGNORECASE)
            for match in matches:
                if int(match[0]) < 7 and int(match[1]) < 7:
                    scores.add(f"{match[0]}-{match[1]}")

        results['scores'] = list(scores)

        # Over/Under
        over_under = {}
        for threshold in ['0.5', '1.5', '2.5', '3.5', '4.5']:
            if re.search(rf'over\s+{threshold}', text, re.IGNORECASE):
                over_under[threshold] = 'Over'
            elif re.search(rf'under\s+{threshold}', text, re.IGNORECASE):
                over_under[threshold] = 'Under'

        results['over_under'] = over_under

        # BTTS
        if re.search(r'both\s+teams?\s+(?:to\s+)?score.*?(?:yes|likely)', text, re.IGNORECASE):
            results['btts'] = 'Yes'
        elif re.search(r'both\s+teams?\s+(?:to\s+)?score.*?(?:no|unlikely)', text, re.IGNORECASE):
            results['btts'] = 'No'

        return results

    def _extract_confidence_phrases(self, text):
        """Extract confidence indicators using ML"""
        confidence_indicators = {
            'high': ['certainly', 'definitely', 'surely', 'will definitely', 'guaranteed', 'confident'],
            'medium': ['should', 'likely', 'probably', 'expected', 'favored'],
            'low': ['might', 'could', 'possibly', 'perhaps', 'maybe']
        }

        found_phrases = {
            'high': 0,
            'medium': 0,
            'low': 0
        }

        text_lower = text.lower()
        for level, phrases in confidence_indicators.items():
            for phrase in phrases:
                found_phrases[level] += len(re.findall(rf'\b{phrase}\b', text_lower))

        return found_phrases

    def _assess_reasoning_quality(self, text):
        """Assess quality of reasoning in prediction"""
        quality_score = 0

        # Check for statistics
        stats_patterns = [
            r'\d+\.?\d*%',  # Percentages
            r'scored \d+ goals',  # Goal statistics
            r'won \d+ of',  # Win records
            r'average of \d+',  # Averages
            r'xG|expected goals',  # Advanced metrics
            r'possession',  # Tactical stats
        ]

        for pattern in stats_patterns:
            if re.search(pattern, text, re.IGNORECASE):
                quality_score += 1

        # Check for tactical analysis
        tactical_terms = [
            'formation', 'tactics', 'pressing', 'counter-attack',
            'defensive', 'attacking', 'midfield', 'strategy'
        ]

        for term in tactical_terms:
            if term in text.lower():
                quality_score += 0.5

        # Check for player analysis
        if re.search(r'injured|suspended|unavailable', text, re.IGNORECASE):
            quality_score += 1

        # Check for historical context
        if re.search(r'last \d+ (?:games|matches|meetings)', text, re.IGNORECASE):
            quality_score += 1

        return min(quality_score, 10)  # Cap at 10

    def detect_bias_indicators(self, text, domain):
        """Detect various types of bias in article"""
        bias_scores = {
            'promotional_bias': 0,
            'recency_bias': 0,
            'favorite_bias': 0,
            'home_bias': 0,
            'affiliate_bias': 0
        }

        # 1. Promotional bias (betting site promotion)
        promo_patterns = [
            r'bet now', r'claim bonus', r'special offer',
            r'promoted odds', r'enhanced odds', r'sign up',
            r'deposit bonus', r'free bet'
        ]

        for pattern in promo_patterns:
            if re.search(pattern, text, re.IGNORECASE):
                bias_scores['promotional_bias'] += 1

        # 2. Recency bias (overweighting recent results)
        recent_patterns = [
            r'last (?:game|match)', r'recent form',
            r'current streak', r'lately'
        ]

        historical_patterns = [
            r'historically', r'all-time record',
            r'head-to-head', r'past meetings'
        ]

        recent_count = sum(1 for p in recent_patterns if re.search(p, text, re.IGNORECASE))
        historical_count = sum(1 for p in historical_patterns if re.search(p, text, re.IGNORECASE))

        if recent_count > historical_count * 2:
            bias_scores['recency_bias'] = (recent_count - historical_count) / max(recent_count, 1)

        # 3. Favorite bias (always picking favorites)
        if 'underdog' not in text.lower() and 'upset' not in text.lower():
            bias_scores['favorite_bias'] += 0.5

        # 4. Affiliate bias
        if re.search(r'affiliate|partner|sponsored', text, re.IGNORECASE):
            bias_scores['affiliate_bias'] += 1

        return bias_scores

    def detect_duplicate_content(self, all_articles):
        """Detect if articles are copying each other"""
        if len(all_articles) < 2:
            return []

        # Extract non-empty content
        valid_articles = []
        contents = []
        for article in all_articles:
            if article.get('content') and len(article['content'].strip()) > 100:
                valid_articles.append(article)
                contents.append(article['content'])

        if len(contents) < 2:
            print("  ℹ️ Not enough valid content for duplicate detection")
            return []

        try:
            # Vectorize
            vectors = self.tfidf_vectorizer.fit_transform(contents)

            # Calculate similarity
            similarity_matrix = cosine_similarity(vectors)

            # Find duplicates
            duplicates = []
            for i in range(len(contents)):
                for j in range(i + 1, len(contents)):
                    similarity = similarity_matrix[i][j]
                    if similarity > 0.8:  # 80% similar
                        duplicates.append({
                            'article1': valid_articles[i]['url'],
                            'article2': valid_articles[j]['url'],
                            'similarity': similarity
                        })

            return duplicates

        except Exception as e:
            print(f"  ⚠️ Duplicate detection error: {str(e)}")
            return []

    def calculate_source_credibility(self, article_analysis):
        """Calculate credibility score for each source"""
        credibility_score = 5.0  # Start at neutral

        # Domain reputation (you can expand this)
        trusted_domains = ['espn.com', 'bbc.com', 'skysports.com', 'athletic.com']
        questionable_domains = ['betting-tips-free.com', 'sure-wins.com']

        domain = article_analysis['domain']

        if any(trusted in domain for trusted in trusted_domains):
            credibility_score += 2
        elif any(questionable in domain for questionable in questionable_domains):
            credibility_score -= 2

        # Reasoning quality
        reasoning_score = article_analysis['predictions']['reasoning_quality']
        credibility_score += (reasoning_score / 10) * 2  # Max +2

        # Bias penalties
        bias_scores = article_analysis['bias_scores']
        total_bias = sum(bias_scores.values())
        credibility_score -= min(total_bias, 3)  # Max -3 penalty

        # Statistical evidence bonus
        if reasoning_score > 5:
            credibility_score += 1

        # Normalize to 0-10
        return max(0, min(10, credibility_score))

