    def _analyze_sentiment_ml(self, text):
        """Advanced sentiment analysis using ML"""
        # Check for empty text
        if not text or len(text.strip()) < 10:
            return {
                'ml_sentiment': 0,
                'confidence': 0,
                'method': 'None (empty text)'
            }

        if self.sentiment_pipeline:
            try:
                # Use BERT-based sentiment
                text_sample = text[:512] if len(text) > 512 else text  # BERT limit
                result = self.sentiment_pipeline(text_sample)

                # Convert 1-5 star rating to -1 to 1 scale
                stars = int(result[0]['label'].split()[0])
                sentiment_score = (stars - 3) / 2  # Convert to -1 to 1

                return {
                    'ml_sentiment': sentiment_score,
                    'confidence': result[0]['score'],
                    'method': 'BERT'
                }
            except Exception as e:
                print(f"  ⚠️ Sentiment analysis error: {str(e)}")

        # Fallback to TextBlob
        try:
            text_sample = text[:1000] if len(text) > 1000 else text
            blob = TextBlob(text_sample)
            return {
                'ml_sentiment': blob.sentiment.polarity,
                'confidence': abs(blob.sentiment.polarity),
                'method': 'TextBlob'
            }
        except:
            return {
                'ml_sentiment': 0,
                'confidence': 0,
                'method': 'Failed'
            }

    def build_weighted_consensus(self):
        """Build consensus with ML-weighted voting"""
        print("\n⚖️ Building ML-Weighted Consensus...")
        print("=" * 60)

        # Calculate weights based on credibility and quality
        weights = []
        for analysis in self.article_analyses:
            weight = analysis['credibility_score'] / 10  # Normalize to 0-1

            # Reduce weight for high bias
            total_bias = sum(analysis['bias_scores'].values())
            weight *= (1 - min(total_bias * 0.1, 0.5))  # Max 50% reduction

            weights.append(weight)

        # Normalize weights
        total_weight = sum(weights)
        if total_weight > 0:
            weights = [w / total_weight for w in weights]
        else:
            weights = [1 / len(weights) for _ in weights]

        # Weighted voting for winner
        winner_votes = {}

        for i, analysis in enumerate(self.article_analyses):
            # Use ML prediction if pattern matching failed
            if analysis['predictions']['winner']:
                winner = analysis['predictions']['winner']
            elif 'implicit_predictions' in analysis['predictions']:
                winner = analysis['predictions']['implicit_predictions']['ml_winner']
            else:
                continue

            if winner not in winner_votes:
                winner_votes[winner] = 0

            winner_votes[winner] += weights[i]

        # Build consensus
        self.consensus_data = {
            'match': f"{self.home_team} vs {self.away_team}",
            'date': self.match_date,
            'sources_analyzed': len(self.article_analyses),
            'ml_enhanced': True
        }

        # Winner consensus
        if winner_votes:
            sorted_winners = sorted(winner_votes.items(), key=lambda x: x[1], reverse=True)
            total_votes = sum(winner_votes.values())

            self.consensus_data['winner'] = {
                'prediction': sorted_winners[0][0],
                'weighted_score': sorted_winners[0][1],
                'confidence': f"{(sorted_winners[0][1] / total_votes * 100):.1f}%",
                'all_predictions': dict(sorted_winners)
            }

        # Quality metrics
        self.consensus_data['quality_metrics'] = {
            'avg_credibility': np.mean([a['credibility_score'] for a in self.article_analyses]),
            'avg_reasoning_quality': np.mean([a['predictions']['reasoning_quality'] for a in self.article_analyses]),
            'high_quality_sources': sum(1 for a in self.article_analyses if a['credibility_score'] > 7),
            'low_quality_sources': sum(1 for a in self.article_analyses if a['credibility_score'] < 3)
        }

        # Bias summary
        all_biases = {
            'promotional': [],
            'recency': [],
            'favorite': [],
            'affiliate': []
        }

        for analysis in self.article_analyses:
            for bias_type, score in analysis['bias_scores'].items():
                if score > 0:
                    all_biases[bias_type.replace('_bias', '')].append({
                        'domain': analysis['domain'],
                        'score': score
                    })

        self.consensus_data['bias_summary'] = all_biases

        print(
            f"\n📊 Weighted Winner: {self.consensus_data['winner']['prediction']} ({self.consensus_data['winner']['confidence']})")
        print(f"📈 Average Credibility: {self.consensus_data['quality_metrics']['avg_credibility']:.1f}/10")
        print(f"🎯 High Quality Sources: {self.consensus_data['quality_metrics']['high_quality_sources']}")
        print(f"⚠️ Low Quality Sources: {self.consensus_data['quality_metrics']['low_quality_sources']}")

