class RiskAssessmentMLPredictor(MLEnhancedMatchPredictor):
    """
    Extended ML Predictor with Risk Assessment for betting markets
    """

    def __init__(self, match_info):
        super().__init__(match_info)
        self.market_predictions = defaultdict(dict)
        self.risk_assessments = {}

    def extract_market_predictions(self, text):
        """Extract predictions for all betting markets"""
        predictions = {
            'over_under': {},
            'btts': None,
            'corners': {},
            'cards': {},
            'moneyline': None,
            'spread': {},
            'clean_sheet': {},
            'goal_scorers': [],
            'halftime': {}
        }

        # Over/Under Goals
        for threshold in ['0.5', '1.5', '2.5', '3.5', '4.5']:
            # Over patterns
            over_patterns = [
                rf'over\s+{threshold}(?:\s+goals?)?',
                rf'more\s+than\s+{threshold}(?:\s+goals?)?',
                rf'(?:expect|predict).*?(?:at\s+least|minimum)\s+{int(float(threshold) + 0.5)}(?:\s+goals?)?'
            ]

            # Under patterns
            under_patterns = [
                rf'under\s+{threshold}(?:\s+goals?)?',
                rf'(?:less|fewer)\s+than\s+{threshold}(?:\s+goals?)?',
                rf'(?:expect|predict).*?(?:maximum|at\s+most)\s+{int(float(threshold))}(?:\s+goals?)?'
            ]

            for pattern in over_patterns:
                if re.search(pattern, text, re.IGNORECASE):
                    predictions['over_under'][threshold] = 'Over'
                    break

            for pattern in under_patterns:
                if re.search(pattern, text, re.IGNORECASE):
                    predictions['over_under'][threshold] = 'Under'
                    break

        # BTTS (Both Teams to Score)
        btts_yes_patterns = [
            r'both\s+teams?\s+(?:to\s+)?score.*?(?:yes|likely|expect)',
            r'BTTS.*?(?:yes|likely)',
            r'(?:expect|predict).*?both.*?(?:score|goal)',
            r'open\s+game.*?goals\s+(?:from|at)\s+both\s+ends'
        ]

        btts_no_patterns = [
            r'both\s+teams?\s+(?:to\s+)?score.*?(?:no|unlikely)',
            r'BTTS.*?(?:no|unlikely)',
            r'clean\s+sheet',
            r'(?:one|1)\s+team\s+(?:to\s+)?(?:dominate|score)'
        ]

        for pattern in btts_yes_patterns:
            if re.search(pattern, text, re.IGNORECASE):
                predictions['btts'] = 'Yes'
                break

        for pattern in btts_no_patterns:
            if re.search(pattern, text, re.IGNORECASE):
                predictions['btts'] = 'No'
                break

        # Corners
        corner_patterns = [
            r'(?:over|under)\s+(\d+\.?\d*)\s+corners',
            r'(\d+)\+?\s+corners',
            r'corners.*?(?:over|under)\s+(\d+\.?\d*)'
        ]

        for pattern in corner_patterns:
            matches = re.findall(pattern, text, re.IGNORECASE)
            for match in matches:
                if 'over' in text[max(0, text.find(match[0]) - 20):text.find(match[0]) + 20].lower():
                    predictions['corners'][match[0]] = 'Over'
                elif 'under' in text[max(0, text.find(match[0]) - 20):text.find(match[0]) + 20].lower():
                    predictions['corners'][match[0]] = 'Under'

        # Moneyline/Winner
        winner_patterns = [
            (rf'{self.home_team}\s+(?:to |will |should )\s*win', self.home_team),
            (rf'{self.away_team}\s+(?:to |will |should )\s*win', self.away_team),
            (rf'back\s+{self.home_team}', self.home_team),
            (rf'back\s+{self.away_team}', self.away_team),
            (r'draw|tie|stalemate', 'Draw')
        ]

        for pattern, team in winner_patterns:
            if re.search(pattern, text, re.IGNORECASE):
                predictions['moneyline'] = team
                break

        # Spread/Handicap
        spread_patterns = [
            rf'{self.home_team}\s+(?:-|\+)(\d+\.?\d*)',
            rf'{self.away_team}\s+(?:-|\+)(\d+\.?\d*)',
            r'handicap\s+(?:-|\+)(\d+\.?\d*)'
        ]

        for pattern in spread_patterns:
            matches = re.findall(pattern, text, re.IGNORECASE)
            for match in matches:
                if self.home_team in pattern:
                    predictions['spread']['home'] = match
                elif self.away_team in pattern:
                    predictions['spread']['away'] = match

        # Clean sheets
        clean_sheet_patterns = [
            (rf'{self.home_team}.*?clean\s+sheet', self.home_team),
            (rf'{self.away_team}.*?clean\s+sheet', self.away_team),
            (rf'clean\s+sheet.*?{self.home_team}', self.home_team),
            (rf'clean\s+sheet.*?{self.away_team}', self.away_team)
        ]

        for pattern, team in clean_sheet_patterns:
            if re.search(pattern, text, re.IGNORECASE):
                predictions['clean_sheet'][team] = True

        return predictions

    def aggregate_market_predictions(self):
        """Aggregate predictions across all sources for each market"""
        market_aggregates = defaultdict(lambda: defaultdict(int))

        for analysis in self.article_analyses:
            weight = analysis['credibility_score'] / 10  # Use credibility as weight

            # Get extended predictions
            extended_predictions = self.extract_market_predictions(analysis['content'])

            # Aggregate Over/Under
            for threshold, prediction in extended_predictions['over_under'].items():
                market_aggregates['over_under'][f"{threshold}_{prediction}"] += weight

            # Aggregate BTTS
            if extended_predictions['btts']:
                market_aggregates['btts'][extended_predictions['btts']] += weight

            # Aggregate Moneyline
            if extended_predictions['moneyline']:
                market_aggregates['moneyline'][extended_predictions['moneyline']] += weight

            # Aggregate Corners
            for corner_line, prediction in extended_predictions['corners'].items():
                market_aggregates['corners'][f"{corner_line}_{prediction}"] += weight

            # Aggregate Clean Sheets
            for team, cs in extended_predictions['clean_sheet'].items():
                if cs:
                    market_aggregates['clean_sheet'][team] += weight

        return market_aggregates

    def calculate_market_confidence(self, market_aggregates):
        """Calculate confidence levels for each market prediction"""
        market_confidence = {}

        for market, predictions in market_aggregates.items():
            if not predictions:
                continue

            total_weight = sum(predictions.values())
            if total_weight == 0:
                continue

            # Calculate confidence for each option
            market_confidence[market] = {}
            for option, weight in predictions.items():
                confidence = (weight / total_weight) * 100
                market_confidence[market][option] = {
                    'confidence': confidence,
                    'weight': weight,
                    'sources': int(weight * 10)  # Approximate number of sources
                }

        return market_confidence

    def assess_risk_levels(self, market_confidence):
        """Categorize predictions into risk levels"""
        risk_categories = {
            'safer': [],  # 70%+ confidence
            'moderate': [],  # 50-70% confidence
            'risky': [],  # <50% confidence
            'avoid': []  # Conflicting or low data
        }

        # Over/Under Analysis
        if 'over_under' in market_confidence:
            for threshold in ['0.5', '1.5', '2.5', '3.5', '4.5']:
                over_key = f"{threshold}_Over"
                under_key = f"{threshold}_Under"

                over_conf = market_confidence['over_under'].get(over_key, {}).get('confidence', 0)
                under_conf = market_confidence['over_under'].get(under_key, {}).get('confidence', 0)

                # Determine dominant prediction
                if over_conf > under_conf:
                    prediction = f"Over {threshold}"
                    confidence = over_conf
                elif under_conf > over_conf:
                    prediction = f"Under {threshold}"
                    confidence = under_conf
                else:
                    continue

                # Risk assessment based on confidence and threshold
                risk_adjustment = self._adjust_risk_for_threshold(threshold, prediction)
                adjusted_confidence = confidence * risk_adjustment

                entry = {
                    'market': 'Goals Over/Under',
                    'prediction': prediction,
                    'confidence': confidence,
                    'adjusted_confidence': adjusted_confidence,
                    'sources': market_confidence['over_under'][over_key if over_conf > under_conf else under_key][
                        'sources']
                }

                if adjusted_confidence >= 70:
                    risk_categories['safer'].append(entry)
                elif adjusted_confidence >= 50:
                    risk_categories['moderate'].append(entry)
                elif adjusted_confidence >= 30:
                    risk_categories['risky'].append(entry)
                else:
                    risk_categories['avoid'].append(entry)

        # BTTS Analysis
        if 'btts' in market_confidence:
            yes_conf = market_confidence['btts'].get('Yes', {}).get('confidence', 0)
            no_conf = market_confidence['btts'].get('No', {}).get('confidence', 0)

            if yes_conf > no_conf:
                prediction = "BTTS Yes"
                confidence = yes_conf
            elif no_conf > yes_conf:
                prediction = "BTTS No"
                confidence = no_conf
            else:
                prediction = None

            if prediction:
                entry = {
                    'market': 'Both Teams to Score',
                    'prediction': prediction,
                    'confidence': confidence,
                    'adjusted_confidence': confidence,
                    'sources': market_confidence['btts']['Yes' if yes_conf > no_conf else 'No']['sources']
                }

                if confidence >= 70:
                    risk_categories['safer'].append(entry)
                elif confidence >= 50:
                    risk_categories['moderate'].append(entry)
                else:
                    risk_categories['risky'].append(entry)

        # Moneyline Analysis
        if 'moneyline' in market_confidence:
            best_prediction = max(market_confidence['moneyline'].items(),
                                  key=lambda x: x[1]['confidence'])

            entry = {
                'market': 'Moneyline',
                'prediction': best_prediction[0],
                'confidence': best_prediction[1]['confidence'],
                'adjusted_confidence': best_prediction[1]['confidence'],
                'sources': best_prediction[1]['sources']
            }

            if best_prediction[1]['confidence'] >= 75:
                risk_categories['safer'].append(entry)
            elif best_prediction[1]['confidence'] >= 55:
                risk_categories['moderate'].append(entry)
            else:
                risk_categories['risky'].append(entry)

        # Corners Analysis
        if 'corners' in market_confidence and market_confidence['corners']:
            for corner_pred, data in market_confidence['corners'].items():
                entry = {
                    'market': 'Corners',
                    'prediction': corner_pred.replace('_', ' '),
                    'confidence': data['confidence'],
                    'adjusted_confidence': data['confidence'] * 0.8,  # Corners are generally riskier
                    'sources': data['sources']
                }

                if data['confidence'] >= 80:
                    risk_categories['moderate'].append(entry)
                else:
                    risk_categories['risky'].append(entry)

        return risk_categories

    def _adjust_risk_for_threshold(self, threshold, prediction):
        """Adjust risk based on threshold and prediction type"""
        # Lower thresholds are generally safer for Over, higher for Under
        adjustments = {
            '0.5': {'Over': 1.2, 'Under': 0.7},  # Over 0.5 is very safe
            '1.5': {'Over': 1.1, 'Under': 0.9},  # Over 1.5 is quite safe
            '2.5': {'Over': 1.0, 'Under': 1.0},  # Neutral
            '3.5': {'Over': 0.9, 'Under': 1.1},  # Under 3.5 is safer
            '4.5': {'Over': 0.7, 'Under': 1.2}  # Under 4.5 is very safe
        }

        prediction_type = 'Over' if 'Over' in prediction else 'Under'
        return adjustments.get(threshold, {}).get(prediction_type, 1.0)

    def analyze_historical_patterns(self):
        """Analyze historical patterns mentioned in articles"""
        historical_insights = {
            'h2h_mentioned': 0,
            'recent_form': 0,
            'scoring_patterns': [],
            'defensive_records': []
        }

        for analysis in self.article_analyses:
            content = analysis['content'].lower()

            # Check for H2H mentions
            if re.search(r'head\s*to\s*head|h2h|previous\s+meetings?|last\s+\d+\s+meetings?', content):
                historical_insights['h2h_mentioned'] += 1

            # Check for recent form
            if re.search(r'last\s+\d+\s+(?:games?|matches?)|recent\s+form|current\s+form', content):
                historical_insights['recent_form'] += 1

            # Extract scoring patterns
            scoring_patterns = re.findall(r'(?:scored|conceded)\s+(\d+)\s+goals?\s+in\s+(?:last\s+)?(\d+)', content)
            historical_insights['scoring_patterns'].extend(scoring_patterns)

            # Extract defensive records
            clean_sheet_mentions = re.findall(r'(\d+)\s+clean\s+sheets?\s+in\s+(?:last\s+)?(\d+)', content)
            historical_insights['defensive_records'].extend(clean_sheet_mentions)

        return historical_insights

