    def fetch_article_content(self, url):
        """
        STEP 1: WEB SCRAPING
        What it does: Downloads the webpage and extracts readable text
        """
        try:
            # Set headers to avoid being blocked
            headers = {
                'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36'
            }

            # Download the webpage
            response = requests.get(url, headers=headers, timeout=10)

            # Parse HTML using BeautifulSoup
            soup = BeautifulSoup(response.content, 'html.parser')

            # Extract text from article containers
            text = ""
            # Look for common article HTML tags
            for tag in ['article', 'main', 'div.content', 'div.article-body', 'section']:
                elements = soup.select(tag)
                if elements:
                    for elem in elements:
                        text += elem.get_text() + " "

            # Fallback: get all paragraphs if no article container found
            if not text:
                paragraphs = soup.find_all('p')
                text = ' '.join([p.get_text() for p in paragraphs])

            # Clean the text (remove extra spaces, newlines)
            text = re.sub(r'\s+', ' ', text).strip()

            return {
                'url': url,
                'domain': urlparse(url).netloc,
                'content': text[:10000],  # Limit to 10k characters
                'status': 'success'
            }

        except Exception as e:
            return {
                'url': url,
                'domain': urlparse(url).netloc,
                'content': '',
                'status': f'error: {str(e)}'
            }

    def extract_predictions(self, text):
        """
        STEP 2: PREDICTION EXTRACTION
        What it does: Uses pattern matching to find predictions in the text
        """
        predictions = {
            'winner': None,
            'scores': [],
            'over_under': {},
            'btts': None,
            'confidence_words': [],
            'handicap': None
        }

        # WINNER EXTRACTION
        # Look for phrases that indicate a winner prediction
        winner_patterns = [
            # Direct predictions
            (r'Juventus\s+(?:to |will |should )\s*win', 'Juventus'),
            (r'Al[- ]Ain\s+(?:to |will |should )\s*win', 'Al Ain'),
            # Indirect predictions
            (r'(?:backing|favou?r|predict|tip).*?Juventus', 'Juventus'),
            (r'(?:backing|favou?r|predict|tip).*?Al[- ]Ain', 'Al Ain'),
            # Result predictions
            (r'Juventus\s+(?:victory|win)', 'Juventus'),
            (r'Al[- ]Ain\s+(?:victory|win)', 'Al Ain')
        ]

        for pattern, team in winner_patterns:
            if re.search(pattern, text, re.IGNORECASE):
                predictions['winner'] = team
                break

        # SCORE EXTRACTION
        # Look for scoreline predictions (e.g., "2-1", "3-0")
        score_patterns = [
            r'(\d)\s*[-–:]\s*(\d)',  # Basic pattern: 2-1, 3:0
            r'Juventus\s+(\d)\s*[-–:]\s*(\d)\s+Al[- ]Ain',  # Team names included
            r'Al[- ]Ain\s+(\d)\s*[-–:]\s*(\d)\s+Juventus'  # Reverse order
        ]

        for pattern in score_patterns:
            matches = re.findall(pattern, text)
            for match in matches:
                # Only keep realistic football scores (< 10 goals)
                if int(match[0]) < 10 and int(match[1]) < 10:
                    predictions['scores'].append(f"{match[0]}-{match[1]}")

        # OVER/UNDER GOALS EXTRACTION
        # Look for total goals predictions
        thresholds = ['0.5', '1.5', '2.5', '3.5', '4.5']
        for threshold in thresholds:
            if re.search(rf'over\s+{threshold}\s*goals', text, re.IGNORECASE):
                predictions['over_under'][f'over_{threshold}'] = 'Yes'
            elif re.search(rf'under\s+{threshold}\s*goals', text, re.IGNORECASE):
                predictions['over_under'][f'over_{threshold}'] = 'No'

        # BOTH TEAMS TO SCORE (BTTS)
        if re.search(r'both\s+teams?\s+(?:to\s+)?score.*?yes', text, re.IGNORECASE):
            predictions['btts'] = 'Yes'
        elif re.search(r'both\s+teams?\s+(?:to\s+)?score.*?no', text, re.IGNORECASE):
            predictions['btts'] = 'No'

        # CONFIDENCE INDICATORS
        # Words that indicate how confident the prediction is
        confidence_indicators = ['likely', 'probable', 'certain', 'expect', 'should',
                                 'will', 'definitely', 'surely', 'confident']
        for word in confidence_indicators:
            if word in text.lower():
                predictions['confidence_words'].append(word)

        # HANDICAP BETTING
        handicap_match = re.search(r'Juventus\s+[-+](\d+\.?\d*)', text)
        if handicap_match:
            predictions['handicap'] = f"Juventus {handicap_match.group(0)}"

        return predictions

    def analyze_sentiment(self, text):
        """
        STEP 3: SENTIMENT ANALYSIS
        What it does: Analyzes the tone/mood of text about each team
        """
        # Split text into sentences
        sentences = text.split('.')

        juventus_sentiments = []
        al_ain_sentiments = []

        # Analyze sentiment for sentences mentioning each team
        for sentence in sentences:
            if len(sentence) > 10:  # Skip very short sentences
                if 'Juventus' in sentence:
                    blob = TextBlob(sentence)
                    juventus_sentiments.append(blob.sentiment.polarity)

                if 'Al Ain' in sentence or 'Al-Ain' in sentence:
                    blob = TextBlob(sentence)
                    al_ain_sentiments.append(blob.sentiment.polarity)

        # Calculate average sentiment
        # Positive = favorable, Negative = unfavorable
        results = {
            'juventus_sentiment': np.mean(juventus_sentiments) if juventus_sentiments else 0,
            'al_ain_sentiment': np.mean(al_ain_sentiments) if al_ain_sentiments else 0,
            'overall_sentiment': TextBlob(text[:1000]).sentiment.polarity
        }

        # Determine which team has more positive coverage
        if results['juventus_sentiment'] > results['al_ain_sentiment'] + 0.1:
            results['sentiment_favors'] = 'Juventus'
        elif results['al_ain_sentiment'] > results['juventus_sentiment'] + 0.1:
            results['sentiment_favors'] = 'Al Ain'
        else:
            results['sentiment_favors'] = 'Neutral'

        return results

    def extract_key_information(self, text):
        """
        STEP 4: KEY INFORMATION EXTRACTION
        What it does: Finds important match factors mentioned in articles
        """
        key_info = {
            'injuries': [],
            'missing_players': [],
            'key_players': [],
            'tactical_points': [],
            'historical_facts': []
        }

        # INJURY DETECTION
        injury_patterns = [
            r'(\w+)\s+(?:is\s+)?(?:injured|ruled out|doubtful|fitness)',
            r'(?:injury|injuries)\s+to\s+(\w+)',
            r'(\w+)\s+(?:miss|misses|missing)'
        ]

        for pattern in injury_patterns:
            matches = re.findall(pattern, text, re.IGNORECASE)
            key_info['injuries'].extend(matches)

        # KEY PLAYER MENTIONS
        # Look for player names with positive context
        key_player_patterns = [
            r'(?:star|key player|talisman)\s+(\w+\s+\w+)',
            r'(\w+\s+\w+)\s+(?:crucial|important|vital)',
        ]

        for pattern in key_player_patterns:
            matches = re.findall(pattern, text)
            key_info['key_players'].extend(matches)

        # TACTICAL INFORMATION
        if 'formation' in text.lower() or 'tactics' in text.lower():
            key_info['tactical_points'].append('Tactical analysis present')

        if 'defensive' in text.lower() and 'solid' in text.lower():
            key_info['tactical_points'].append('Defensive strength mentioned')

        if 'attacking' in text.lower() or 'offensive' in text.lower():
            key_info['tactical_points'].append('Attacking play discussed')

        # HISTORICAL CONTEXT
        if re.search(r'last\s+\d+\s+(?:games|matches)', text):
            key_info['historical_facts'].append('Recent form discussed')

        if re.search(r'never\s+(?:won|lost|beaten)', text):
            key_info['historical_facts'].append('Historical record mentioned')

        return key_info

