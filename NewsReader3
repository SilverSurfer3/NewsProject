    def build_consensus(self):
        """
        STEP 5: CONSENSUS BUILDING
        What it does: Combines all predictions to find the most likely outcomes
        """
        self.explain_step(
            "BUILDING CONSENSUS",
            "The model now combines all predictions using:\n" +
            "1. Majority voting for winner predictions\n" +
            "2. Frequency analysis for score predictions\n" +
            "3. Percentage calculations for over/under bets\n" +
            "4. Confidence scoring based on agreement levels"
        )

        # Initialize collectors
        all_winners = []
        all_scores = []
        all_btts = []
        over_under_votes = {
            '0.5': [], '1.5': [], '2.5': [], '3.5': [], '4.5': []
        }
        all_sentiments = {'juventus': [], 'al_ain': []}
        all_injuries = []

        # Collect all predictions
        for analysis in self.article_analyses:
            # Winners
            if analysis['predictions']['winner']:
                all_winners.append(analysis['predictions']['winner'])

            # Scores
            all_scores.extend(analysis['predictions']['scores'])

            # BTTS
            if analysis['predictions']['btts']:
                all_btts.append(analysis['predictions']['btts'])

            # Over/Under
            for threshold in over_under_votes.keys():
                key = f'over_{threshold}'
                if key in analysis['predictions']['over_under']:
                    over_under_votes[threshold].append(
                        analysis['predictions']['over_under'][key]
                    )

            # Sentiments
            all_sentiments['juventus'].append(analysis['sentiment']['juventus_sentiment'])
            all_sentiments['al_ain'].append(analysis['sentiment']['al_ain_sentiment'])

            # Injuries
            all_injuries.extend(analysis['key_info']['injuries'])

        # BUILD CONSENSUS
        consensus = {
            'sources_analyzed': len(self.article_analyses),
            'match': self.match_string,
            'date': self.match_date
        }

        # Winner consensus
        if all_winners:
            winner_counts = Counter(all_winners)
            most_common = winner_counts.most_common(1)[0]
            total_predictions = len(all_winners)

            consensus['winner'] = {
                'prediction': most_common[0],
                'votes': f"{most_common[1]}/{total_predictions}",
                'confidence': f"{(most_common[1] / total_predictions * 100):.0f}%",
                'all_predictions': dict(winner_counts)
            }

            print(f"\n🏆 Winner Consensus: {most_common[0]} with {most_common[1]}/{total_predictions} votes")

        # Score consensus
        if all_scores:
            score_counts = Counter(all_scores)
            top_scores = score_counts.most_common(3)

            consensus['scores'] = {
                'most_likely': top_scores[0][0],
                'frequency': f"{top_scores[0][1]}/{len(all_scores)}",
                'alternatives': [s[0] for s in top_scores[1:]]
            }

            # Calculate average goals
            total_goals = []
            for score in all_scores:
                try:
                    h, a = map(int, score.split('-'))
                    total_goals.append(h + a)
                except:
                    pass

            if total_goals:
                consensus['average_total_goals'] = np.mean(total_goals)

            print(f"📊 Most likely score: {top_scores[0][0]} (appeared {top_scores[0][1]} times)")

        # Over/Under consensus
        consensus['over_under'] = {}
        for threshold, votes in over_under_votes.items():
            if votes:
                yes_votes = votes.count('Yes')
                total_votes = len(votes)
                percentage = (yes_votes / total_votes) * 100

                # Determine safety level
                if percentage >= 85:
                    safety = "VERY SAFE ✅"
                elif percentage >= 70:
                    safety = "SAFE ✅"
                elif percentage >= 55:
                    safety = "MODERATE ⚠️"
                elif percentage >= 40:
                    safety = "RISKY ⚠️"
                else:
                    safety = "VERY RISKY ❌"

                consensus['over_under'][f'over_{threshold}'] = {
                    'recommendation': 'Yes' if yes_votes > total_votes / 2 else 'No',
                    'confidence': f"{max(yes_votes, total_votes - yes_votes) / total_votes * 100:.0f}%",
                    'safety': safety,
                    'votes': f"{yes_votes}/{total_votes}"
                }

        # BTTS consensus
        if all_btts:
            yes_votes = all_btts.count('Yes')
            consensus['btts'] = {
                'prediction': 'Yes' if yes_votes > len(all_btts) / 2 else 'No',
                'confidence': f"{max(yes_votes, len(all_btts) - yes_votes) / len(all_btts) * 100:.0f}%",
                'votes': f"{yes_votes}/{len(all_btts)}"
            }

        # Sentiment consensus
        consensus['sentiment'] = {
            'juventus_avg': np.mean(all_sentiments['juventus']),
            'al_ain_avg': np.mean(all_sentiments['al_ain']),
            'favors': 'Juventus' if np.mean(all_sentiments['juventus']) > np.mean(
                all_sentiments['al_ain']) else 'Al Ain'
        }

        # Injury report
        if all_injuries:
            injury_counts = Counter(all_injuries)
            consensus['injuries'] = injury_counts.most_common(5)

        self.consensus_data = consensus
        return consensus

    def generate_recommendations(self):
        """
